#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(git rev-parse --show-toplevel)"
repo_name="$(basename "${repo_dir}")"
repo_parent="$(dirname "${repo_dir}")"

image="${FURIOS_IMAGE:-localhost/furios-forky-arm64:latest}"
volume_suffix="${FURIOS_VOLUME_SUFFIX:-:Z}"
command=("$@")

if [[ "${#command[@]}" -eq 0 ]]; then
    command=(bash)
fi

if [[ "${image}" != containers-storage:* ]]; then
    image="containers-storage:${image}"
fi

exec podman run --rm -it \
    --arch arm64 \
    --pull=never \
    -v "${repo_parent}:/src${volume_suffix}" \
    -w "/src/${repo_name}" \
    "${image}" \
    "${command[@]}"
